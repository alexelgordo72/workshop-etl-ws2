version: '3.8'

# ========================================
# WS2 - Stack ETL con Airflow + PostgreSQL
# Puerto host PostgreSQL: 5435
# Puerto host Airflow: 8082
# ========================================

x-airflow-common: &airflow-common
  build: .
  env_file: .env
  environment:
    AIRFLOW__CORE__EXECUTOR: LocalExecutor
    AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
    AIRFLOW__CORE__FERNET_KEY: ${AIRFLOW__CORE__FERNET_KEY}
    AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION: 'true'
    AIRFLOW__CORE__LOAD_EXAMPLES: 'false'
    AIRFLOW__WEBSERVER__SECRET_KEY: ${AIRFLOW__WEBSERVER__SECRET_KEY}
    AIRFLOW__API__AUTH_BACKENDS: 'airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session'
    AIRFLOW__SCHEDULER__DAG_DIR_LIST_INTERVAL: 30
    GOOGLE_APPLICATION_CREDENTIALS: /opt/airflow/credentials/gcp-key.json
    GCP_PROJECT_ID: ${GCP_PROJECT_ID}
    GCS_BUCKET_NAME: ${GCS_BUCKET_NAME}
  volumes:
    - ./dags:/opt/airflow/dags
    - ./scripts:/opt/airflow/scripts
    - ./data:/opt/airflow/data
    - ./logs:/opt/airflow/logs
    - ./credentials:/opt/airflow/credentials
    - ./config:/opt/airflow/config
  user: "${AIRFLOW_UID:-50000}:0"
  depends_on:
    postgres_ws2:
      condition: service_healthy
  networks:
    - ws2_network

services:

  postgres_ws2:
    image: postgres:16-alpine
    container_name: ws2_postgres
    environment:
o
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    ports:
      - "5435:5432"
    volumes:
      - ws2_postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "${POSTGRES_USER}"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - ws2_network

  airflow-webserver:
    <<: *airflow-common
    container_name: ws2_airflow_webserver
    command: webserver
    ports:
      - "8082:8080"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "--fail", "http://localhost:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 5

  airflow-scheduler:
    <<: *airflow-common
    container_name: ws2_airflow_scheduler
    command: scheduler
    restart: unless-stopped

  airflow-init:
    <<: *airflow-common
    container_name: ws2_airflow_init
    entrypoint: /bin/bash
    command:
      - -c
      - |
        set -e
        echo "==============================================="
        echo "  Inicializando Airflow WS2"
        echo "==============================================="
        echo ""
        echo "[1/3] Creando carpetas necesarias..."
        mkdir -p /opt/airflow/logs/scheduler
        mkdir -p /opt/airflow/logs/dag_processor_manager
        mkdir -p /opt/airflow/logs/webserver
        chmod -R 777 /opt/airflow/logs
        echo "✅ Carpetas creadas"
        echo ""
        echo "[2/3] Ejecutando migraciones de base de datos..."
        airflow db migrate
        echo "✅ Migraciones completadas"
        echo ""
        echo "[3/3] Creando usuario admin..."
        airflow users create \
          --username admin \
          --firstname Admin \
          --lastname WS2 \
          --role Admin \
          --email admin@ws2.local \
          --password admin
        echo "✅ Usuario admin creado"
        echo ""
        echo "==============================================="
        echo "  ✅ AIRFLOW INICIALIZADO CORRECTAMENTE"
        echo "==============================================="

networks:
  ws2_network:
    driver: bridge

volumes:
  ws2_postgres_data:

